# public/avatars/.htaccess
# Запрет выполнения любых скриптов
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|php-s|pht|phar|cgi|pl|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Отключаем движок PHP на уровне директории
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Отключаем исполнение через CGI
Options -ExecCGI

# Принудительно отдаём изображения с правильным MIME
<FilesMatch "\.(jpg|jpeg)$">
    ForceType image/jpeg
</FilesMatch>
<FilesMatch "\.png$">
    ForceType image/png
</FilesMatch>
<FilesMatch "\.webp$">
    ForceType image/webp
</FilesMatch>
<FilesMatch "\.gif$">
    ForceType image/gif
</FilesMatch>
